# VeriProof Backend Production Environment Variables Example

# Server Configuration
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://your-app-name.vercel.app
ALLOW_VERCEL_PREVIEWS=false

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/veriproof?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_long_random_jwt_secret_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=veriproof-76123
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@veriproof-76123.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# AI Engine / Gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_ENGINE_URL=http://127.0.0.1:8000

# Optional Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=veriproof.platform@gmail.com
SMTP_PASS=your_app_password_here
FROM_NAME=VeriProof
FROM_EMAIL=veriproof.platform@gmail.com
